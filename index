<meta name='viewport' content='width=device-width, initial-scale=1'/><!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    
    <!-- Настройки для превращения в приложение на iOS -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Control Center">
    
    <title>Control Center</title>
    <style>
        :root {
            --bg-color: #000000;
            --surface: rgba(28, 28, 30, 0.6);
            --surface-card: rgba(28, 28, 30, 0.6);
            --border: rgba(255, 255, 255, 0.12);
            --text-main: #f5f5f7;
            --text-secondary: #86868b;
            --accent: #0a84ff;
            --danger: #ff453a;
            --success: #30d158;
            --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Segoe UI", Roboto, sans-serif;
            --hero-card-bg: rgba(28, 28, 30, 0.6);
            --ios-slider-fill: rgba(255, 255, 255, 0.85);
            --blur-val: blur(25px);
        }

        /* Режим без прозрачности */
        body.no-transparency {
            --surface: #1c1c1e;
            --surface-card: #1c1c1e;
            --hero-card-bg: #1c1c1e;
            --blur-val: none;
        }

        /* Светлая тема */
        body.theme-light {
            --bg-color: #f2f2f7;
            --surface: rgba(255, 255, 255, 0.7);
            --surface-card: rgba(255, 255, 255, 0.7);
            --border: rgba(0, 0, 0, 0.08);
            --text-main: #000000;
            --text-secondary: #8e8e93;
            --accent: #007aff;
            --hero-card-bg: rgba(255, 255, 255, 0.7);
            --ios-slider-fill: rgba(0, 0, 0, 0.8);
        }

        body.theme-light.no-transparency {
            --surface: #ffffff;
            --surface-card: #ffffff;
            --hero-card-bg: #ffffff;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: var(--font); -webkit-tap-highlight-color: transparent; }
        body { background: var(--bg-color); color: var(--text-main); height: 100vh; height: 100dvh; display: flex; flex-direction: column; overflow: hidden; padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom); transition: background 0.3s, color 0.3s; }

        .app-views { flex: 1; position: relative; overflow: hidden; display: flex; }
        .view { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; background: var(--bg-color); opacity: 0; pointer-events: none; transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1); transform: scale(0.98); }
        .view.active { opacity: 1; pointer-events: auto; transform: scale(1); }

        .nav-header { display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.4); backdrop-filter: var(--blur-val); -webkit-backdrop-filter: var(--blur-val); z-index: 10; }
        body.theme-light .nav-header { background: rgba(255,255,255,0.4); }
        .nav-title { font-size: 17px; font-weight: 600; letter-spacing: -0.4px; }
        .nav-icon-btn { background: none; border: none; color: var(--text-main); font-size: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center; }

        /* Овальная нижняя навигация */
        .tab-bar-container { position: absolute; bottom: calc(20px + env(safe-area-inset-bottom)); left: 0; width: 100%; display: flex; justify-content: center; z-index: 100; pointer-events: none; }
        .tab-bar { display: flex; justify-content: space-around; align-items: center; width: 90%; max-width: 380px; height: 60px; background: rgba(28, 28, 30, 0.75); backdrop-filter: var(--blur-val); -webkit-backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 35px; padding: 0 10px; box-shadow: 0 12px 36px rgba(0,0,0,0.4); pointer-events: auto; }
        body.theme-light .tab-bar { background: rgba(255, 255, 255, 0.8); }

        .tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; background: none; border: none; color: var(--text-secondary); cursor: pointer; font-size: 10px; font-weight: 500; transition: color 0.2s, transform 0.1s; }
        .tab-item:active { transform: scale(0.92); }
        .tab-item svg { width: 22px; height: 22px; fill: currentColor; }
        .tab-item.active { color: var(--accent); }

        .content-scroll { flex: 1; overflow-y: auto; padding: 20px 20px 95px 20px; display: flex; flex-direction: column; gap: 20px; }
        
        .section-header-row { display: flex; justify-content: space-between; align-items: center; margin-left: 4px; margin-right: 4px; margin-bottom: 8px; }
        .section-title { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-secondary); }
        .add-btn-icon { background: var(--surface); border: 1px solid var(--border); color: var(--text-main); width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 16px; font-weight: 600; transition: transform 0.15s; }
        .add-btn-icon:active { transform: scale(0.88); }

        /* Карточки */
        .card { background: var(--surface-card); backdrop-filter: var(--blur-val); -webkit-backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 36px; padding: 22px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 8px 32px rgba(0,0,0,0.12); }

        /* Карточка аватара */
        .hero-banner { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px 20px; background: var(--hero-card-bg); backdrop-filter: var(--blur-val); -webkit-backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 40px; text-align: center; gap: 12px; transition: background 0.3s; box-shadow: 0 8px 32px rgba(0,0,0,0.12); }
        
        .avatar-wrapper { position: relative; width: 96px; height: 96px; }
        .hero-avatar { width: 100%; height: 100%; border-radius: 50%; background-color: #2c2c2e; border: 2px solid rgba(255, 255, 255, 0.2); display: flex; align-items: center; justify-content: center; color: #ffffff; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4); overflow: hidden; position: relative; }
        
        .avatar-svg-icon { width: 44px; height: 44px; fill: #8e8e93; position: absolute; z-index: 1; }
        .avatar-img-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-size: cover; background-position: center; z-index: 2; display: none; }

        .pencil-btn { position: absolute; bottom: 0; right: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--surface); border: 1px solid var(--border); color: var(--text-main); display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.3); transition: transform 0.15s; z-index: 5; }
        .pencil-btn:active { transform: scale(0.88); }
        .pencil-btn svg { width: 14px; height: 14px; fill: var(--text-main); }

        .avatar-editor-panel { width: 100%; background: var(--surface); backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 28px; padding: 16px; display: none; flex-direction: column; gap: 10px; margin-top: 6px; text-align: left; }
        .avatar-editor-panel.open { display: flex; }
        
        .gallery-btn { width: 100%; background: var(--accent); border: none; color: #ffffff; padding: 12px; border-radius: 18px; font-size: 14px; font-weight: 600; cursor: pointer; text-align: center; display: flex; align-items: center; justify-content: center; gap: 8px; transition: opacity 0.2s; }
        .gallery-btn:active { opacity: 0.8; }

        /* Сценарии (округлые) */
        .scenarios-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        .scenario-card { background: var(--surface); backdrop-filter: var(--blur-val); -webkit-backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 36px; padding: 18px 10px; text-align: center; cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; align-items: center; gap: 6px; box-shadow: 0 4px 16px rgba(0,0,0,0.05); }
        .scenario-card:active { transform: scale(0.95); background: rgba(255,255,255,0.1); }
        .scenario-icon svg { width: 22px; height: 22px; fill: var(--text-main); }
        .scenario-label { font-size: 12px; font-weight: 500; }

        /* Будильник */
        .alarm-card { background: var(--surface); backdrop-filter: var(--blur-val); -webkit-backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 32px; padding: 22px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 16px rgba(0,0,0,0.05); }
        .alarm-time { font-size: 26px; font-weight: 700; }
        .alarm-sub { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }

        /* Погода */
        .weather-card { background: linear-gradient(135deg, rgba(28, 28, 30, 0.8) 0%, rgba(15, 28, 46, 0.8) 100%); backdrop-filter: var(--blur-val); -webkit-backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 36px; padding: 22px; display: flex; justify-content: space-between; align-items: center; color: #fff; box-shadow: 0 8px 32px rgba(0,0,0,0.15); }
        .weather-temp { font-size: 34px; font-weight: 700; letter-spacing: -1px; }
        .weather-city { font-size: 15px; font-weight: 600; margin-bottom: 2px; }
        .weather-desc { font-size: 12px; opacity: 0.8; }
        .weather-icon svg { width: 38px; height: 38px; fill: #fff; }

        /* Датчики */
        .sensors-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .sensor-card { background: var(--surface); backdrop-filter: var(--blur-val); -webkit-backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 32px; padding: 20px; display: flex; flex-direction: column; gap: 6px; box-shadow: 0 4px 16px rgba(0,0,0,0.05); }
        .sensor-icon svg { width: 20px; height: 20px; fill: var(--text-secondary); }
        .sensor-val { font-size: 22px; font-weight: 700; }
        .sensor-label { font-size: 12px; color: var(--text-secondary); font-weight: 500; }

        /* Чат */
        .chat-scroll { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 16px; }
        .message-row { display: flex; width: 100%; }
        .message-row.user { justify-content: flex-end; }
        .message-row.assistant { justify-content: flex-start; }
        .bubble { max-width: 85%; padding: 12px 18px; border-radius: 24px; font-size: 15px; line-height: 1.45; word-break: break-word; }
        .message-row.user .bubble { background: var(--accent); color: #fff; border-bottom-right-radius: 6px; }
        .message-row.assistant .bubble { background: var(--surface); backdrop-filter: var(--blur-val); border: 1px solid var(--border); color: var(--text-main); border-bottom-left-radius: 6px; }
        
        .chat-input-box { flex: 1; background: var(--surface); backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 30px; display: flex; align-items: center; padding: 8px 16px; gap: 8px; }
        .chat-input-box textarea { flex: 1; background: none; border: none; color: var(--text-main); font-size: 15px; resize: none; max-height: 100px; outline: none; }
        .action-btn { background: var(--accent); color: #fff; border: none; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 16px; flex-shrink: 0; transition: transform 0.15s; }
        .action-btn:active { transform: scale(0.9); }
        .mic-btn-chat { background: var(--surface); color: var(--text-main); border: 1px solid var(--border); }
        .mic-btn-chat.recording { background: var(--danger); border-color: var(--danger); animation: pulse-mic 1.5s infinite; color: #fff; }

        @keyframes pulse-mic { 0% { transform: scale(1); } 50% { transform: scale(1.08); } 100% { transform: scale(1); } }

        /* Подсветка */
        .led-preview-box { position: relative; height: 140px; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, rgba(0,0,0,0) 70%); border-radius: 28px; overflow: hidden; }
        .led-gradient-sphere { width: 84px; height: 84px; border-radius: 50%; background: linear-gradient(135deg, #007aff, #af52de, #ff2d55); box-shadow: 0 0 35px rgba(0, 122, 255, 0.5); transition: all 0.4s ease; }
        .led-gradient-sphere.pulse { animation: sphereGlow 2.5s infinite alternate; }
        .led-gradient-sphere.rainbow { animation: rainbowRotate 4s linear infinite; background: linear-gradient(135deg, #ff2d55, #ff9500, #34c759, #007aff); }
        .led-gradient-sphere.matrix { animation: matrixGlow 1.2s infinite alternate; background: linear-gradient(135deg, #30d158, #30b0c7); }

        @keyframes sphereGlow { 0% { transform: scale(0.95); box-shadow: 0 0 20px rgba(0, 122, 255, 0.4); } 100% { transform: scale(1.08); box-shadow: 0 0 50px rgba(175, 82, 222, 0.8); } }
        @keyframes rainbowRotate { 0% { filter: hue-rotate(0deg); } 100% { filter: hue-rotate(360deg); } }
        @keyframes matrixGlow { 0% { box-shadow: 0 0 15px #30d158; } 100% { box-shadow: 0 0 40px #30d158; } }

        .led-mode-selector { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
        .mode-btn { background: var(--surface); backdrop-filter: var(--blur-val); border: 1px solid var(--border); color: var(--text-main); padding: 10px; border-radius: 20px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.2s; }
        .mode-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

        .feature-toggle-row { display: flex; justify-content: space-between; align-items: center; background: var(--surface); backdrop-filter: var(--blur-val); padding: 16px 20px; border-radius: 28px; border: 1px solid var(--border); }
        .feature-info { display: flex; flex-direction: column; gap: 2px; }
        .feature-title { font-size: 15px; font-weight: 400; }
        .feature-desc { font-size: 12px; color: var(--text-secondary); }

        .device-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .device-card { background: var(--surface); backdrop-filter: var(--blur-val); -webkit-backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 32px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; height: 120px; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 16px rgba(0,0,0,0.05); }
        .device-card.active { background: rgba(10, 132, 255, 0.15); border-color: var(--accent); }
        .device-card-top { display: flex; justify-content: space-between; align-items: center; }
        .device-icon svg { width: 22px; height: 22px; fill: var(--text-main); }
        
        /* Свитч в стиле iOS */
        .ios-switch { width: 51px; height: 31px; background: rgba(120, 120, 128, 0.3); border-radius: 16px; position: relative; transition: background 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer; }
        .ios-switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 27px; height: 27px; background: #fff; border-radius: 50%; transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 3px 8px rgba(0,0,0,0.25); }
        .ios-switch.active { background: var(--success); }
        .ios-switch.active::after { transform: translateX(20px); }

        /* Настройки в стиле iOS */
        .settings-group { display: flex; flex-direction: column; gap: 1px; background: var(--border); border-radius: 32px; overflow: hidden; border: 1px solid var(--border); backdrop-filter: var(--blur-val); }
        .setting-row { display: flex; justify-content: space-between; align-items: center; background: var(--surface); padding: 16px 20px; gap: 12px; }
        .setting-label { font-size: 15px; font-weight: 400; color: var(--text-main); }
        .setting-input { background: transparent; border: none; color: var(--text-secondary); font-size: 15px; text-align: right; outline: none; width: 140px; }
        .setting-select { background: transparent; border: none; color: var(--text-secondary); font-size: 15px; outline: none; text-align: right; cursor: pointer; }
        
        /* Слайдеры iOS Control Center */
        .ios-slider-card { background: var(--surface); backdrop-filter: var(--blur-val); border: 1px solid var(--border); border-radius: 32px; padding: 18px 20px; display: flex; flex-direction: column; gap: 10px; }
        .ios-slider-header { display: flex; justify-content: space-between; align-items: center; font-size: 15px; font-weight: 400; }
        .ios-slider-wrapper { position: relative; width: 100%; height: 40px; background: rgba(120, 120, 128, 0.2); border-radius: 20px; overflow: hidden; display: flex; align-items: center; padding: 0 14px; }
        .ios-slider { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 5; }
        .ios-slider-fill { position: absolute; top: 0; left: 0; height: 100%; background: var(--ios-slider-fill); border-radius: 20px; pointer-events: none; transition: width 0.05s linear, background 0.3s ease; }
        .ios-slider-content { position: relative; width: 100%; display: flex; justify-content: space-between; align-items: center; z-index: 2; pointer-events: none; }
        .ios-slider-content svg { width: 18px; height: 18px; fill: var(--text-secondary); }

        textarea.setting-textarea { width: 100%; background: transparent; border: none; color: var(--text-main); font-size: 14px; resize: none; outline: none; line-height: 1.4; padding: 4px 0; }
        
        .save-btn { width: 100%; background: var(--accent); color: #fff; border: none; padding: 16px; border-radius: 28px; font-size: 16px; font-weight: 600; cursor: pointer; transition: opacity 0.2s; box-shadow: 0 4px 14px rgba(10, 132, 255, 0.3); }
        .save-btn:active { opacity: 0.8; }

        /* Модальное окно кадрирования аватара */
        .crop-modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 1000; padding: 20px; gap: 20px; }
        .crop-modal.open { display: flex; }
        .crop-container { position: relative; width: 260px; height: 260px; border-radius: 50%; overflow: hidden; border: 3px solid var(--accent); background: #1c1c1e; box-shadow: 0 10px 40px rgba(0,0,0,0.6); touch-action: none; }
        .crop-container img { position: absolute; cursor: grab; user-select: none; max-width: none; max-height: none; }
        .crop-mask-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 50%; box-shadow: 0 0 0 2000px rgba(0, 0, 0, 0.6); pointer-events: none; }
        .crop-controls { width: 100%; max-width: 280px; display: flex; flex-direction: column; gap: 14px; align-items: center; }
        .crop-buttons { display: flex; gap: 10px; width: 100%; }
        .crop-btn { flex: 1; padding: 12px; border-radius: 18px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; }
        .crop-btn.cancel { background: var(--surface); color: var(--text-main); border: 1px solid var(--border); }
        .crop-btn.ok { background: var(--accent); color: #fff; }
    </style>
</head>
<body>

    <!-- Скрытый системный выбор файла из галереи -->
    <input type="file" id="galleryFileInput" accept="image/*" style="display: none;" onchange="initCrop(event)">

    <!-- Модальное окно кадрирования и зума -->
    <div class="crop-modal" id="cropModal">
        <div style="font-size: 17px; font-weight: 600; color: #fff;">Подгонка аватара</div>
        <div class="crop-container" id="cropContainer">
            <img id="cropImage" src="" alt="Crop Source">
            <div class="crop-mask-overlay"></div>
        </div>
        <div class="crop-controls">
            <input type="range" id="zoomSlider" min="0.5" max="3" step="0.01" value="1" style="width: 100%; cursor: pointer;" oninput="applyZoom(this.value)">
            <div class="crop-buttons">
                <button class="crop-btn cancel" onclick="closeCropModal()">Отмена</button>
                <button class="crop-btn ok" onclick="saveCroppedAvatar()">Готово</button>
            </div>
        </div>
    </div>

    <div class="app-views">
        
        <!-- 1. ГЛАВНАЯ -->
        <div class="view active" id="view-main">
            <div class="nav-header">
                <div class="nav-title">Control Center</div>
                <div style="font-size: 13px; color: var(--success); font-weight: 600;">● Online</div>
            </div>
            <div class="content-scroll">
                
                <!-- Аватарка -->
                <div class="hero-banner" id="heroCardBanner">
                    <div class="avatar-wrapper">
                        <div class="hero-avatar" id="avatarContainer">
                            <svg class="avatar-svg-icon" id="avatarSvg" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
                            <div class="avatar-img-layer" id="avatarImgLayer"></div>
                        </div>
                        <button class="pencil-btn" onclick="toggleAvatarEditor()" title="Загрузить фото">
                            <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                        </button>
                    </div>

                    <!-- Панель настройки аватара -->
                    <div class="avatar-editor-panel" id="avatarEditorPanel">
                        <button class="gallery-btn" onclick="openGallery()">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                            Загрузить фото из галереи
                        </button>
                    </div>

                    <div style="font-size: 20px; font-weight: 700; margin-top: 2px;" id="botNameDisplay">Серега</div>
                    <div style="font-size: 12px; color: var(--text-secondary);">DeepSeek & Home Assistant активны</div>
                </div>

                <!-- Сценарии -->
                <div>
                    <div class="section-header-row">
                        <div class="section-title">Сценарии</div>
                        <button class="add-btn-icon" onclick="addNewScenario()" title="Добавить новый сценарий">+</button>
                    </div>
                    <div class="scenarios-grid" id="scenariosGrid">
                        <div class="scenario-card" onclick="alert('Сценарий «Я дома» активирован!')">
