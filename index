    <script>
        let currentAvatarData = '';
        
        const cropImg = document.getElementById('cropImage');
        const cropContainer = document.getElementById('cropContainer');
        const zoomSlider = document.getElementById('zoomSlider');
        let imgNaturalWidth = 0;
        let imgNaturalHeight = 0;
        let baseScale = 1;
        let currentZoom = 1;
        let imgX = 0;
        let imgY = 0;
        let isDragging = false;
        let startX = 0;
        let startY = 0;

        function switchView(viewName, btn) {
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
            document.getElementById('view-' + viewName).classList.add('active');
            btn.classList.add('active');
        }

        const chatScroll = document.getElementById('chatScroll');
        const chatInput = document.getElementById('chatInput');
        let isRecording = false;

        function autoResize(textarea) {
            textarea.style.height = 'auto';
            textarea.style.height = textarea.scrollHeight + 'px';
        }

        function updateIosSlider(input, fillId, valId) {
            const val = input.value;
            document.getElementById(fillId).style.width = val + '%';
            document.getElementById(valId).textContent = val + '%';
        }

        function sendChatMessage() {
            const text = chatInput.value.trim();
            if (!text) return;
            appendMsg(text, 'user');
            chatInput.value = '';
            chatInput.style.height = 'auto';

            setTimeout(() => {
                appendMsg("Сделано, босс! Запрос обработан.", 'assistant');
            }, 800);
        }

        function appendMsg(text, sender) {
            const row = document.createElement('div');
            row.className = `message-row ${sender}`;
            const bubble = document.createElement('div');
            bubble.className = 'bubble';
            bubble.textContent = text;
            row.appendChild(bubble);
            chatScroll.appendChild(row);
            chatScroll.scrollTop = chatScroll.scrollHeight;
        }

        function toggleVoice() {
            isRecording = !isRecording;
            const micBtn = document.getElementById('micBtn');
            if (isRecording) {
                micBtn.classList.add('recording');
                chatInput.placeholder = "Слушаю...";
                setTimeout(() => {
                    if (isRecording) toggleVoice();
                    appendMsg("Поставь будильник на 7 утра", 'user');
                    setTimeout(() => {
                        appendMsg("Будильник на 07:00 заряжен.", 'assistant');
                    }, 800);
                }, 3000);
            } else {
                micBtn.classList.remove('recording');
                chatInput.placeholder = "Спроси ассистента...";
            }
        }

        function clearChat() {
            chatScroll.innerHTML = '';
            appendMsg("История очищена. Чего командуешь?", 'assistant');
        }

        function setLedMode(mode, btn) {
            document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('ledSphere').className = 'led-gradient-sphere ' + mode;
        }

        function toggleDeviceCard(card) {
            card.classList.toggle('active');
            const sw = card.querySelector('.ios-switch');
            if (sw) sw.classList.toggle('active');
        }

        function addNewDevice() {
            const deviceName = prompt("Введите название устройства:");
            if (!deviceName) return;
            const grid = document.getElementById('deviceGrid');
            const newCard = document.createElement('div');
            newCard.className = 'device-card active';
            newCard.setAttribute('onclick', 'toggleDeviceCard(this)');
            newCard.innerHTML = `
                <div class="device-card-top">
                    <span class="device-icon">
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                    </span>
                    <div class="ios-switch active"></div>
                </div>
                <div style="font-size: 14px; font-weight: 500;">${deviceName}</div>
            `;
            grid.appendChild(newCard);
        }

        function addNewScenario() {
            const name = prompt("Введите название нового сценария:");
            if (!name) return;
            const grid = document.getElementById('scenariosGrid');
            const card = document.createElement('div');
            card.className = 'scenario-card';
            card.setAttribute('onclick', `alert('Сценарий «${name}» активирован!')`);
            card.innerHTML = `
                <span class="scenario-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                </span>
                <span class="scenario-label">${name}</span>
            `;
            grid.appendChild(card);
        }

        function updateBotIdentity() {
            const name = document.getElementById('botNameInput').value || 'Серега';
            document.getElementById('botNameDisplay').textContent = name;
        }

        function updateAvatarDisplay(imgData) {
            const svgIcon = document.getElementById('avatarSvg');
            const imgLayer = document.getElementById('avatarImgLayer');
            
            if (imgData && imgData.trim() !== '') {
                currentAvatarData = imgData;
                imgLayer.style.backgroundImage = `url(${imgData})`;
                imgLayer.style.display = 'block';
                svgIcon.style.display = 'none';
            } else {
                currentAvatarData = '';
                imgLayer.style.backgroundImage = 'none';
                imgLayer.style.display = 'none';
                svgIcon.style.display = 'block';
            }
        }

        function openGallery() {
            document.getElementById('galleryFileInput').click();
        }

        function initCrop(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                cropImg.onload = function() {
                    imgNaturalWidth = cropImg.naturalWidth;
                    imgNaturalHeight = cropImg.naturalHeight;
                    
                    baseScale = 260 / Math.min(imgNaturalWidth, imgNaturalHeight);
                    currentZoom = 1;
                    zoomSlider.value = 1;

                    imgX = (260 - imgNaturalWidth * baseScale) / 2;
                    imgY = (260 - imgNaturalHeight * baseScale) / 2;
                    updateTransform();

                    document.getElementById('cropModal').classList.add('open');
                    toggleAvatarEditor();
                };
                cropImg.src = e.target.result;
            };
            reader.readAsDataURL(file);
            event.target.value = '';
        }

        function applyZoom(val) {
            currentZoom = parseFloat(val);
            updateTransform();
        }

        function updateTransform() {
            const scale = baseScale * currentZoom;
            cropImg.style.width = (imgNaturalWidth * scale) + 'px';
            cropImg.style.height = (imgNaturalHeight * scale) + 'px';
            cropImg.style.left = imgX + 'px';
            cropImg.style.top = imgY + 'px';
        }

        cropContainer.addEventListener('mousedown', startDrag);
        cropContainer.addEventListener('touchstart', startDrag, {passive: false});

        window.addEventListener('mousemove', drag);
        window.addEventListener('touchmove', drag, {passive: false});

        window.addEventListener('mouseup', endDrag);
        window.addEventListener('touchend', endDrag);

        function startDrag(e) {
            isDragging = true;
            startX = e.clientX || e.touches[0].clientX;
            startY = e.clientY || e.touches[0].clientY;
            e.preventDefault();
        }

        function drag(e) {
            if (!isDragging) return;
            const clientX = e.clientX || e.touches[0].clientX;
            const clientY = e.clientY || e.touches[0].clientY;
            
            imgX += clientX - startX;
            imgY += clientY - startY;
            
            startX = clientX;
            startY = clientY;
            updateTransform();
            e.preventDefault();
        }

        function endDrag() {
            isDragging = false;
        }

        function closeCropModal() {
            document.getElementById('cropModal').classList.remove('open');
        }

        function saveCroppedAvatar() {
            const canvas = document.createElement('canvas');
            canvas.width = 300;
            canvas.height = 300;
            const ctx = canvas.getContext('2d');

            const scale = baseScale * currentZoom;
            const sourceX = -imgX / scale;
            const sourceY = -imgY / scale;
            const sourceSize = 260 / scale;

            ctx.drawImage(cropImg, sourceX, sourceY, sourceSize, sourceSize, 0, 0, 300, 300);
            
            const finalDataUrl = canvas.toDataURL('image/jpeg', 0.9);
            updateAvatarDisplay(finalDataUrl);
            closeCropModal();
        }

        function toggleAvatarEditor() {
            const panel = document.getElementById('avatarEditorPanel');
            panel.classList.toggle('open');
        }

        function setHeroBgColor(hexColor) {
            document.getElementById('heroCardBanner').style.background = hexColor;
        }

        function changeTheme(theme) {
            if (theme === 'light') {
                document.body.classList.add('theme-light');
            } else {
                document.body.classList.remove('theme-light');
            }
        }

        function toggleTransparency(sw) {
            sw.classList.toggle('active');
            if (sw.classList.contains('active')) {
                document.body.classList.remove('no-transparency');
            } else {
                document.body.classList.add('no-transparency');
            }
        }

        function saveAllSettings() {
            const isTrans = document.getElementById('transparencySwitch').classList.contains('active');
            const settings = {
                botName: document.getElementById('botNameInput').value,
                avatarData: currentAvatarData,
                heroBg: document.getElementById('heroCardBanner').style.background,
                theme: document.getElementById('themeSelect').value,
                transparency: isTrans
            };
            try {
                localStorage.setItem('serega_settings', JSON.stringify(settings));
                alert('Все настройки сохранены!');
            } catch (err) {
                alert('Ошибка сохранения: изображение слишком большое.');
            }
        }

        function loadSettings() {
            const saved = localStorage.getItem('serega_settings');
            if (!saved) return;
            try {
                const s = JSON.parse(saved);
                if (s.botName) {
                    document.getElementById('botNameInput').value = s.botName;
                    updateBotIdentity();
                }
                if (s.avatarData) {
                    updateAvatarDisplay(s.avatarData);
                }
                if (s.heroBg) {
                    document.getElementById('heroCardBanner').style.background = s.heroBg;
                    document.getElementById('settingsColorPicker').value = s.heroBg;
                }
                if (s.theme) {
                    document.getElementById('themeSelect').value = s.theme;
                    changeTheme(s.theme);
                }
                if (s.transparency !== undefined) {
                    const sw = document.getElementById('transparencySwitch');
                    if (s.transparency) {
                        sw.classList.add('active');
                        document.body.classList.remove('no-transparency');
                    } else {
                        sw.classList.remove('active');
                        document.body.classList.add('no-transparency');
                    }
                }
            } catch (e) {
                console.error(e);
            }
        }

        chatInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendChatMessage();
            }
        });

        loadSettings();
    </script>
</body>
</html>

